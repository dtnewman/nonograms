# Public URL used in moderation email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use a long random value. Required for the admin login.
ADMIN_PASSWORD=replace-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional locally. Submission still works and logs the review URL without it.
RESEND_API_KEY=
ADMIN_EMAIL=you@example.com
RESEND_FROM=Nonograms <noreply@foobar.dev>

# Keep this on persistent storage in production.
DATABASE_PATH=./data/nonograms.db
