# Copy to ~/.config/nonograms/server.env on your laptop, fill in, then `make env-push`.
# Installed on the box as /etc/nonograms.env (mode 600) and read by both systemd
# and the production build. Plain KEY=value, no `export`, no quotes needed.

# Keep the database off the git checkout so deploys cannot clobber it.
DATABASE_PATH=/home/exedev/.local/share/nonograms/nonograms.db

# Baked into the build — change it and you must re-run `make deploy`, not just restart.
NEXT_PUBLIC_SITE_URL=https://nonograms.exe.xyz

ADMIN_PASSWORD=change-me
# openssl rand -hex 32
SESSION_SECRET=change-me

# Optional: submission notification emails. Without these, review URLs are
# printed to the server log instead (make logs).
# RESEND_API_KEY=
# ADMIN_EMAIL=you@example.com
# RESEND_FROM=Nonograms <noreply@yourdomain>
